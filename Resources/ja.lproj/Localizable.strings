"Reset to Defaults" = "デフォルトに戻す";
"Automatic" = "自動";
"Current Input: %@" = "現在の入力: %@";
"%@ Color" = "%@の色";
"KeyHue never records what you type." = "KeyHueは入力内容を記録しません。";
